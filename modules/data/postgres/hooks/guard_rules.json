{
  "command_rules": [
    {
      "id": "confirm-postgres-destructive-cli",
      "pattern": "(?:^|[;&|\\n])\\s*(?:[A-Z_][A-Z0-9_]*=[^\\s;&|\\n]+\\s+){0,5}(?:(?:npx(?:\\s+(?:-y|--yes))?|pnpm\\s+dlx|bunx|poetry\\s+run|uv\\s+run)\\s+)?(?:docker(?:\\s+compose)?\\s+exec\\s+(?:(?:--(?:interactive|tty|detach|privileged|no-TTY)|-[Titd]+|(?:--(?:user|env|workdir)|-[uew])(?:=[^\\s;&|\\n]+|\\s+[^\\s;&|\\n]+))\\s+){0,6}[A-Za-z0-9_.-]+\\s+)?(?:dropdb\\b|pg_restore\\b[^;&|\\n]*\\s(?:-c|--clean)\\b|flyway\\s+clean\\b|prisma\\s+(?:migrate\\s+reset|db\\s+push\\b[^;&|\\n]*(?:--force-reset|--accept-data-loss))|alembic(?:\\s+-c\\s+[^\\s;&|\\n]+)?\\s+downgrade\\s+base\\b|drizzle-kit\\s+drop\\b)",
      "decision": "force_ask",
      "reason": "Destructive PostgreSQL database or migration reset command detected. Explicit human confirmation is required."
    },
    {
      "id": "confirm-postgres-destructive-sql",
      "pattern": "(?i)(?:^|[;&|\\n])\\s*(?:[A-Z_][A-Z0-9_]*=[^\\s;&|\\n]+\\s+){0,5}(?:docker(?:\\s+compose)?\\s+exec\\s+(?:(?:--(?:interactive|tty|detach|privileged|no-TTY)|-[Titd]+|(?:--(?:user|env|workdir)|-[uew])(?:=[^\\s;&|\\n]+|\\s+[^\\s;&|\\n]+))\\s+){0,6}[A-Za-z0-9_.-]+\\s+)?psql\\b\\s+(?:(?:[^\\s;&|\\n\"']+|(?:--command=|-c|<<<)?(?:\"[^\"\\n]{0,300}\"|'[^'\\n]{0,300}'))\\s+){0,10}(?:--command=|-c|<<<)?(?:\"[^\"\\n]{0,400}\\b(?:DROP\\s+(?:DATABASE|SCHEMA|TABLE)|TRUNCATE(?:\\s+(?:TABLE|ONLY))?)\\b[^\"\\n]{0,400}\"|'[^'\\n]{0,400}\\b(?:DROP\\s+(?:DATABASE|SCHEMA|TABLE)|TRUNCATE(?:\\s+(?:TABLE|ONLY))?)\\b[^'\\n]{0,400}'|[^;&|\\n\"']{0,200}\\b(?:DROP\\s+(?:DATABASE|SCHEMA|TABLE)|TRUNCATE(?:\\s+(?:TABLE|ONLY))?)\\b)",
      "decision": "force_ask",
      "reason": "Destructive inline SQL (DROP DATABASE/SCHEMA/TABLE or TRUNCATE) via psql detected. Explicit human confirmation is required."
    },
    {
      "id": "confirm-postgres-piped-destructive-sql",
      "pattern": "(?i)(?:^|[;&|\\n])\\s*(?:echo|printf)\\s+(?:(?:-[A-Za-z]+|\"[^\"\\n]{0,100}\"|'[^'\\n]{0,100}')\\s+){0,3}(?:\"[^\"\\n]{0,400}\\b(?:DROP\\s+(?:DATABASE|SCHEMA|TABLE)|TRUNCATE(?:\\s+(?:TABLE|ONLY))?)\\b[^\"\\n]{0,400}\"|'[^'\\n]{0,400}\\b(?:DROP\\s+(?:DATABASE|SCHEMA|TABLE)|TRUNCATE(?:\\s+(?:TABLE|ONLY))?)\\b[^'\\n]{0,400}'|[^;&|\\n\"']{0,200}\\b(?:DROP\\s+(?:DATABASE|SCHEMA|TABLE)|TRUNCATE(?:\\s+(?:TABLE|ONLY))?)\\b)[^;&|\\n]{0,200}\\|\\s*(?:[A-Z_][A-Z0-9_]*=[^\\s;&|\\n]+\\s+){0,5}(?:docker(?:\\s+compose)?\\s+exec\\s+(?:(?:--(?:interactive|tty|detach|privileged|no-TTY)|-[Titd]+|(?:--(?:user|env|workdir)|-[uew])(?:=[^\\s;&|\\n]+|\\s+[^\\s;&|\\n]+))\\s+){0,6}[A-Za-z0-9_.-]+\\s+)?psql\\b",
      "decision": "force_ask",
      "reason": "Destructive piped SQL (DROP DATABASE/SCHEMA/TABLE or TRUNCATE) into psql detected. Explicit human confirmation is required."
    }
  ]
}
