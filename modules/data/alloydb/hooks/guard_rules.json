{
  "command_rules": [
    {
      "id": "confirm-alloydb-destructive-delete",
      "pattern": "(?:^|[;&|\\n])\\s*(?:[A-Z_][A-Z0-9_]*=[^\\s;&|\\n]+\\s+){0,5}gcloud\\s+(?:(?:--[a-z0-9-]+(?:=[^\\s;&|\\n]+|\\s+[^\\s;&|\\n-][^\\s;&|\\n]*)|-[a-zA-Z])\\s+){0,4}(?:(?:alpha|beta)\\s+)?alloydb\\s+(?:clusters|instances|backups|users)\\s+delete\\b",
      "decision": "force_ask",
      "reason": "Destructive gcloud alloydb delete operation detected (cluster, instance, backup, or user). Explicit human confirmation is required."
    },
    {
      "id": "confirm-alloydb-topology-mutation",
      "pattern": "(?:^|[;&|\\n])\\s*(?:[A-Z_][A-Z0-9_]*=[^\\s;&|\\n]+\\s+){0,5}gcloud\\s+(?:(?:--[a-z0-9-]+(?:=[^\\s;&|\\n]+|\\s+[^\\s;&|\\n-][^\\s;&|\\n]*)|-[a-zA-Z])\\s+){0,4}(?:(?:alpha|beta)\\s+)?alloydb\\s+(?:clusters\\s+(?:promote|switchover|restore)|instances\\s+failover)\\b",
      "decision": "force_ask",
      "reason": "High-impact gcloud alloydb failover, promotion, switchover, or restore operation detected. Explicit human confirmation is required."
    }
  ]
}
