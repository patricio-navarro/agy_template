rules_version = '2';

// Deny-by-default Firestore Security Rules baseline for {{PROJECT_NAME}}.
// Delegate rule modifications to the firestore-rules-author subagent and verify in the Firestore Emulator.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
