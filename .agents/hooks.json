{
  "template-bootstrap": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./hooks/bootstrap_detector.py",
        "timeout": 10
      }
    ]
  },
  "pre-tool-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/pre_tool_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/pre_tool_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/pre_tool_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
